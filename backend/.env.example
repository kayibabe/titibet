# ── Copy to backend/.env and fill in your values ─────────────────────────────
# Never commit backend/.env — it is gitignored.

# === Required ================================================================

# API-Football key (api-sports.io) — used for fixture + odds ingestion.
API_FOOTBALL_KEY=your_api_football_key_here

# Strong random JWT secret — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

# === Database ================================================================

# SQLite path (default). For Fly.io the volume path is set in fly.toml.
DB_URL=sqlite+aiosqlite:///./titibet.db

# === Server ==================================================================

BACKEND_PORT=8010
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# When API_KEY is set every /api/* request must carry X-API-Key: <value>.
# Leave empty to disable (fine for localhost-only dev).
API_KEY=

# Skip the full startup ingestion sync (saves API quota during dev restarts).
# Catch-up settlement still runs.
SKIP_STARTUP_SYNC=true

# Scheduler: comma-separated HH:MM times UTC.
# Production schedule: 04:00 morning refresh, 19:00 evening pull, 23:00 settlement-only.
SYNC_TIMES=04:00,19:00,23:00

# === AI Advisory (optional) ==================================================

# At least one LLM key enables the AI Advisory Council. All are free tiers.
GROQ_API_KEY=           # console.groq.com
TITIBET_CLAUDE_KEY=     # console.anthropic.com  (NOT ANTHROPIC_API_KEY — avoids clash with Claude Code)
GEMINI_API_KEY=         # aistudio.google.com/apikey
CEREBRAS_API_KEY=       # inference.cerebras.ai
MISTRAL_API_KEY=        # console.mistral.ai

# === Telegram Bot (optional) =================================================

TELEGRAM_BOT_TOKEN=             # from @BotFather
TELEGRAM_FREE_CHAT_ID=          # TiTiBet Free channel chat ID
TELEGRAM_PRO_CHAT_ID=           # TiTiBet Pro channel chat ID
TELEGRAM_FREE_INVITE_URL=       # Public invite link shown in welcome emails

# === Email / SMTP (optional) =================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=TiTiBet

APP_URL=http://localhost:5173

# === Payments / Paystack (optional) ==========================================

PAYSTACK_SECRET_KEY=    # sk_test_... or sk_live_...
PAYSTACK_PUBLIC_KEY=    # pk_test_... or pk_live_...
PAYSTACK_CURRENCY=MWK
PAYSTACK_PLAN_PRO_MONTHLY=
PAYSTACK_PLAN_PRO_YEARLY=
